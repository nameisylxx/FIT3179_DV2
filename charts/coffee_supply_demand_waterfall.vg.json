{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "World coffee: how much was grown and how much was drunk",
    "subtitle": [
      "Coffee year 2024/25 (October 2024 to September 2025)",
      "In millions of 60-kilogram bags"
    ]
  },
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/processed/coffee_world_supply_demand_balance.csv"
  },
  "transform": [
    {
      "filter": "datum.coffee_year === '2024/25'"
    },
    {
      "calculate": "toNumber(datum.total_production)",
      "as": "grown"
    },
    {
      "calculate": "toNumber(datum.consumption)",
      "as": "drunk"
    },
    {
      "calculate": "toNumber(datum.balance)",
      "as": "gap"
    },
    {
      "calculate": "[{'step': 'Grown', 'start': 0, 'end': datum.grown, 'value': datum.grown}, {'step': 'Drunk', 'start': datum.grown, 'end': datum.grown - datum.drunk, 'value': datum.drunk}, {'step': 'Shortfall', 'start': 0, 'end': datum.gap, 'value': datum.gap}]",
      "as": "steps"
    },
    {
      "flatten": [
        "steps"
      ]
    },
    {
      "calculate": "datum.steps.step",
      "as": "step"
    },
    {
      "calculate": "datum.steps.start",
      "as": "start"
    },
    {
      "calculate": "datum.steps.end",
      "as": "end"
    },
    {
      "calculate": "datum.steps.value",
      "as": "value"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 70,
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "x": {
          "field": "step",
          "type": "ordinal",
          "sort": [
            "Grown",
            "Drunk",
            "Shortfall"
          ],
          "axis": {
            "title": null,
            "labelFontSize": 13,
            "labelFontWeight": 600,
            "labelAngle": 0,
            "ticks": false,
            "domain": false,
            "labelPadding": 8
          }
        },
        "y": {
          "field": "start",
          "type": "quantitative",
          "scale": {
            "domain": [
              -15,
              200
            ]
          },
          "axis": {
            "title": "Million bags",
            "values": [
              0,
              50,
              100,
              150,
              200
            ],
            "grid": true,
            "gridColor": "#EDE6DC",
            "domain": false,
            "ticks": false
          }
        },
        "y2": {
          "field": "end"
        },
        "color": {
          "field": "step",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grown",
              "Drunk",
              "Shortfall"
            ],
            "range": [
              "#4E7D3A",
              "#5A6D7D",
              "#1B7F79"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "step",
            "title": "Step"
          },
          {
            "field": "value",
            "title": "Million bags",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "y": 0
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#2B1D13",
        "strokeWidth": 1.2
      },
      "encoding": {
        "y": {
          "field": "y",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.step !== 'Shortfall'"
        },
        {
          "calculate": "datum.step === 'Drunk' ? '−' + format(datum.value, '.1f') : format(datum.value, '.1f')",
          "as": "label"
        },
        {
          "calculate": "max(datum.start, datum.end)",
          "as": "top"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -9,
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#2B1D13"
      },
      "encoding": {
        "x": {
          "field": "step",
          "type": "ordinal",
          "sort": [
            "Grown",
            "Drunk",
            "Shortfall"
          ]
        },
        "y": {
          "field": "top",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.step === 'Shortfall'"
        },
        {
          "calculate": "'−' + format(abs(datum.value), '.1f')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": 16,
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#2B1D13"
      },
      "encoding": {
        "x": {
          "field": "step",
          "type": "ordinal",
          "sort": [
            "Grown",
            "Drunk",
            "Shortfall"
          ]
        },
        "y": {
          "field": "end",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "step": "Shortfall",
            "y": 75
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#1B7F79",
        "text": [
          "The world drank 6.3 million",
          "bags more than it grew.",
          "The ICO expects a surplus",
          "of 3.0 million bags in 2025/26."
        ],
        "dx": -14
      },
      "encoding": {
        "x": {
          "field": "step",
          "type": "ordinal",
          "sort": [
            "Grown",
            "Drunk",
            "Shortfall"
          ]
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        }
      }
    }
  ],
  "config": {
    "background": null,
    "font": "Inter, 'Helvetica Neue', Arial, sans-serif",
    "title": {
      "fontSize": 14,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#2B1D13",
      "subtitleFontSize": 12.5,
      "subtitleColor": "#6B5847",
      "subtitlePadding": 4
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#4A3B2E",
      "titleColor": "#2B1D13"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#4A3B2E",
      "titleColor": "#2B1D13"
    },
    "view": {
      "stroke": null
    }
  }
}