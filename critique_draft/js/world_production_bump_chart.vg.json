{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Rank among the world's coffee-growing countries",
    "subtitle": "1 = biggest producer. Ranked by tonnes grown, 76 countries"
  },
  "width": "container",
  "height": 500,
  "data": {
    "url": "data/coffee_production_by_country.csv"
  },
  "transform": [
    {
      "filter": "datum.production_tonnes !== '' && datum.iso3 !== 'CAF' && datum.iso3 !== 'GIN'"
    },
    {
      "calculate": "toNumber(datum.production_tonnes)",
      "as": "tonnes"
    },
    {
      "filter": "datum.year === '1990' || datum.year === '2000' || datum.year === '2010' || datum.year === '2020' || datum.year === '2024'"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "groupby": [
        "year"
      ],
      "sort": [
        {
          "field": "tonnes",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "indexof(['Brazil','Colombia','Vietnam','Indonesia','Mexico','India'], datum.country_name) >= 0"
    },
    {
      "calculate": "datum.country_name === 'Vietnam' ? 'Vietnam' : (datum.country_name === 'Mexico' ? 'Mexico' : 'Other')",
      "as": "focus"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "scale": {
            "padding": 0.55
          },
          "axis": {
            "orient": "top",
            "title": null,
            "labelFontSize": 13,
            "labelFontWeight": 600,
            "domain": false,
            "ticks": false,
            "labelAngle": 0
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              18.5,
              0.5
            ]
          },
          "axis": null
        },
        "detail": {
          "field": "country_name",
          "type": "nominal"
        },
        "color": {
          "field": "focus",
          "type": "nominal",
          "scale": {
            "domain": [
              "Vietnam",
              "Mexico",
              "Other"
            ],
            "range": [
              "#4E7D3A",
              "#2B1D13",
              "#8C8276"
            ]
          },
          "legend": null
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.focus !== 'Other'",
            "value": 4
          },
          "value": 2.5
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 330,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "rank",
          "type": "quantitative"
        },
        "color": {
          "field": "focus",
          "type": "nominal",
          "legend": null
        },
        "tooltip": [
          {
            "field": "country_name",
            "title": "Country"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "rank",
            "title": "Rank"
          },
          {
            "field": "tonnes",
            "title": "Tonnes grown",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#FFFFFF"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "rank",
          "type": "quantitative"
        },
        "text": {
          "field": "rank",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === '1990'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -16,
        "fontSize": 12.5,
        "fontWeight": 600,
        "color": "#2B1D13"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "rank",
          "type": "quantitative"
        },
        "text": {
          "field": "country_name"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === '2024'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 16,
        "fontSize": 12.5,
        "fontWeight": 600,
        "color": "#2B1D13"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "rank",
          "type": "quantitative"
        },
        "text": {
          "field": "country_name"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": "2000",
            "rank": 16.6
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#2F4F22",
        "dx": 14,
        "text": [
          "Vietnam jumped from 17th to 2nd",
          "place between 1990 and 2000,",
          "and now grows 22 times as much."
        ]
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "rank",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": "2010",
            "rank": 13.2
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#2B1D13",
        "dx": -20,
        "text": [
          "Mexico slipped from 3rd",
          "to 11th place."
        ]
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "rank",
          "type": "quantitative"
        }
      }
    }
  ],
  "config": {
    "background": null,
    "font": "Inter, 'Helvetica Neue', Arial, sans-serif",
    "title": {
      "fontSize": 14,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#2B1D13",
      "subtitleFontSize": 12.5,
      "subtitleColor": "#6B5847",
      "subtitlePadding": 4
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#4A3B2E",
      "titleColor": "#2B1D13"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#4A3B2E",
      "titleColor": "#2B1D13"
    },
    "view": {
      "stroke": null
    }
  }
}