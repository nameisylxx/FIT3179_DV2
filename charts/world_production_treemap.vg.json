{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Treemap of 2024 green coffee production: world, then region, then country.",
  "padding": 6,
  "height": 520,
  "title": {
    "text": "Coffee grown in 2024, thousand tonnes, by region and country",
    "anchor": "start",
    "fontSize": 14,
    "fontWeight": 600,
    "color": "#2B1D13",
    "subtitleFontSize": 12.5,
    "subtitleColor": "#6B5847",
    "subtitlePadding": 4,
    "font": "'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif",
    "subtitleFont": "'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif"
  },
  "signals": [
    {
      "name": "width",
      "init": "(containerSize()[0] > 100 ? containerSize()[0] : 540) - 12",
      "on": [
        {
          "events": "window:resize",
          "update": "(containerSize()[0] > 100 ? containerSize()[0] : 540) - 12"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "tree",
      "url": "data/processed/coffee_production_2024_treemap.csv",
      "format": {
        "type": "csv",
        "parse": {
          "id": "number",
          "parent": "number",
          "production_tonnes": "number"
        }
      },
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "production_tonnes",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "method": "binary",
          "round": true,
          "paddingInner": 3,
          "paddingOuter": 3,
          "paddingTop": 24,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ]
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 2"
        }
      ]
    },
    {
      "name": "regions",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 1"
        }
      ]
    },
    {
      "name": "brazil",
      "source": "leaves",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.name === 'Brazil'"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "green",
      "type": "threshold",
      "domain": [
        250000,
        500000,
        1000000,
        2500000
      ],
      "range": [
        "#E3D3BD",
        "#D2B796",
        "#A9825A",
        "#6F4A2F",
        "#3B2416"
      ]
    }
  ],
  "legends": [
    {
      "fill": "green",
      "orient": "bottom",
      "direction": "horizontal",
      "title": "Thousand tonnes grown",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "labelFontSize": 12,
      "format": ",.0f",
      "encode": {
        "labels": {
          "update": {
            "fill": {
              "value": "#4A3B2E"
            },
            "text": {
              "signal": "datum.index === 0 ? 'Under 250' : datum.index === 1 ? '250–500' : datum.index === 2 ? '500–1,000' : datum.index === 3 ? '1,000–2,500' : 'Over 2,500'"
            }
          }
        }
      },
      "symbolType": "square",
      "symbolSize": 180,
      "columns": 3,
      "columnPadding": 14,
      "labelLimit": 200,
      "type": "symbol"
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "regions"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": "#F1EFEA"
          },
          "stroke": {
            "value": "#C9C2B6"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "regions"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0",
            "offset": 6
          },
          "y": {
            "field": "y0",
            "offset": 16
          },
          "text": {
            "signal": "datum.name === 'Central America & Mexico' && datum.x1 - datum.x0 < 200 ? 'Central America' : datum.name"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 6"
          },
          "font": {
            "value": "'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 700
          },
          "fill": {
            "value": "#2B1D13"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "green",
            "field": "production_tonnes"
          },
          "stroke": {
            "value": "#FAF6F0"
          },
          "strokeWidth": {
            "value": 1.5
          },
          "tooltip": {
            "signal": "{'Country': datum.name === 'Other' ? 'Other ' + datum.region + ' countries' : datum.name, 'Region': datum.region, 'Tonnes grown': format(datum.production_tonnes, ',.0f')}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0",
            "offset": 4
          },
          "y": {
            "field": "y0",
            "offset": 16
          },
          "text": {
            "signal": "(datum.x1 - datum.x0) > 40 && (datum.y1 - datum.y0) > 30 ? (datum.name === 'Central African Republic' ? ['Central', 'African', 'Republic'] : datum.name) : ''"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 2"
          },
          "font": {
            "value": "'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "signal": "datum.production_tonnes >= 1000000 ? '#FFFFFF' : '#1F1610'"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0",
            "offset": 4
          },
          "y": {
            "signal": "datum.y0 + (datum.name === 'Central African Republic' ? 60 : 32)"
          },
          "text": {
            "signal": "(datum.x1 - datum.x0) > 40 && (datum.y1 - datum.y0) > (datum.name === 'Central African Republic' ? 70 : 46) ? format(datum.production_tonnes / 1000, ',.0f') : ''"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 6"
          },
          "font": {
            "value": "'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "signal": "datum.production_tonnes >= 1000000 ? '#FFFFFF' : '#1F1610'"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x0 + datum.x1) / 2"
          },
          "y": {
            "field": "y1",
            "offset": -4
          },
          "angle": {
            "value": -90
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "signal": "(datum.x1 - datum.x0) <= 40 && (datum.x1 - datum.x0) >= 14 && (datum.y1 - datum.y0) > 40 ? datum.name + ' ' + format(datum.production_tonnes / 1000, ',.0f') : ''"
          },
          "limit": {
            "signal": "datum.y1 - datum.y0 - 6"
          },
          "font": {
            "value": "'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#1F1610"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "brazil"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0",
            "offset": 9
          },
          "y": {
            "field": "y1",
            "offset": -34
          },
          "text": {
            "value": [
              "Brazil alone: almost a third",
              "of recorded output."
            ]
          },
          "font": {
            "value": "'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "lineHeight": {
            "value": 17
          },
          "fill": {
            "value": "#FFFFFF"
          }
        }
      }
    }
  ]
}
