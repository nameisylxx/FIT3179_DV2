{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Tonnes per hectare, 2015 to 2024, for the ten largest producers of 2024"
  },
  "width": "container",
  "height": 480,
  "padding": {
    "left": 5,
    "top": 5,
    "right": 16,
    "bottom": 5
  },
  "data": {
    "url": "data/processed/coffee_yield_by_country.csv"
  },
  "transform": [
    {
      "filter": "indexof(['Vietnam','Brazil','Honduras','Colombia','Peru','India','Ethiopia','Indonesia','Uganda','Central African Republic'], datum.country_name) >= 0"
    },
    {
      "filter": "datum.yield_tonnes_per_hectare !== '' && toNumber(datum.year) >= 2015"
    },
    {
      "calculate": "toNumber(datum.yield_tonnes_per_hectare)",
      "as": "yield_t_ha"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FAF6F0",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "orient": "top",
            "title": null,
            "labelAngle": 0,
            "labelFontSize": 12,
            "domain": false,
            "ticks": false,
            "labelExpr": "toNumber(datum.value) % 2 === 0 ? datum.value : ''"
          }
        },
        "y": {
          "field": "country_name",
          "type": "nominal",
          "sort": [
            "Vietnam",
            "Brazil",
            "Honduras",
            "Colombia",
            "Peru",
            "India",
            "Ethiopia",
            "Indonesia",
            "Uganda",
            "Central African Republic"
          ],
          "axis": {
            "title": null,
            "labelFontSize": 13,
            "labelFontWeight": 600,
            "domain": false,
            "ticks": false,
            "labelExpr": "datum.label === 'Central African Republic' ? ['Central African', 'Republic'] : datum.label",
            "labelLineHeight": 13
          }
        },
        "color": {
          "field": "yield_t_ha",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.2,
              3.0
            ],
            "range": [
              "#F3EBDD",
              "#DCC6A6",
              "#B9966A",
              "#86643F",
              "#4F3A24"
            ]
          },
          "legend": {
            "title": "Tonnes per hectare",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 220,
            "gradientThickness": 12,
            "values": [
              0.5,
              1,
              1.5,
              2,
              2.5,
              3
            ]
          }
        },
        "tooltip": [
          {
            "field": "country_name",
            "title": "Country"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "yield_t_ha",
            "title": "Tonnes per hectare",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "country_name",
          "type": "nominal",
          "sort": [
            "Vietnam",
            "Brazil",
            "Honduras",
            "Colombia",
            "Peru",
            "India",
            "Ethiopia",
            "Indonesia",
            "Uganda",
            "Central African Republic"
          ],
          "axis": {
            "labelExpr": "datum.label === 'Central African Republic' ? ['Central African', 'Republic'] : datum.label",
            "labelLineHeight": 13
          }
        },
        "text": {
          "field": "yield_t_ha",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "condition": {
            "test": "datum.yield_t_ha > 1.85",
            "value": "#FFFFFF"
          },
          "value": "#2B1D13"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.country_name === 'Vietnam'"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": null,
        "stroke": "#2B1D13",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "country_name",
          "type": "nominal",
          "sort": [
            "Vietnam",
            "Brazil",
            "Honduras",
            "Colombia",
            "Peru",
            "India",
            "Ethiopia",
            "Indonesia",
            "Uganda",
            "Central African Republic"
          ],
          "axis": {
            "labelExpr": "datum.label === 'Central African Republic' ? ['Central African', 'Republic'] : datum.label",
            "labelLineHeight": 13
          }
        }
      }
    }
  ],
  "config": {
    "background": null,
    "font": "'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif",
    "title": {
      "fontSize": 14,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#2B1D13",
      "subtitleFontSize": 12.5,
      "subtitleColor": "#6B5847",
      "subtitlePadding": 4
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#4A3B2E",
      "titleColor": "#2B1D13"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#4A3B2E",
      "titleColor": "#2B1D13"
    },
    "view": {
      "stroke": null
    }
  }
}