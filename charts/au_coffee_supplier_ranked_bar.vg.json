{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Top 8 countries supplying Australia's coffee, 2025",
    "subtitle": "Tonnes of coffee beans imported from coffee-growing countries"
  },
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/processed/au_coffee_imports_by_origin.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum.net_weight_kg) / 1000",
      "as": "tonnes"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "tonnes",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.rank <= 8"
    },
    {
      "calculate": "datum.origin_country === 'Papua New Guinea' ? 'Nearest neighbour' : 'Other'",
      "as": "highlight"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "y": {
          "field": "origin_country",
          "type": "nominal",
          "sort": {
            "field": "tonnes",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "labelFontSize": 13,
            "labelFontWeight": 600,
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "field": "tonnes",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              38000
            ]
          },
          "axis": {
            "title": "Tonnes imported",
            "format": ",.0f",
            "values": [
              0,
              10000,
              20000,
              30000
            ],
            "grid": true,
            "gridColor": "#EDE6DC",
            "domain": false,
            "ticks": false
          }
        },
        "color": {
          "field": "highlight",
          "type": "nominal",
          "scale": {
            "domain": [
              "Nearest neighbour",
              "Other"
            ],
            "range": [
              "#A86B12",
              "#D9902B"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "origin_country",
            "title": "Country of origin"
          },
          {
            "field": "tonnes",
            "title": "Tonnes imported",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 12.5,
        "fontWeight": 600,
        "color": "#2B1D13"
      },
      "encoding": {
        "y": {
          "field": "origin_country",
          "type": "nominal",
          "sort": {
            "field": "tonnes",
            "op": "max",
            "order": "descending"
          }
        },
        "x": {
          "field": "tonnes",
          "type": "quantitative"
        },
        "text": {
          "field": "tonnes",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.origin_country === 'Papua New Guinea'"
        },
        {
          "calculate": "datum.tonnes + 6200",
          "as": "note_x"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 12.5,
        "fontWeight": 600,
        "color": "#A86B12",
        "text": "Our nearest neighbour"
      },
      "encoding": {
        "y": {
          "field": "origin_country",
          "type": "nominal",
          "sort": {
            "field": "tonnes",
            "op": "max",
            "order": "descending"
          }
        },
        "x": {
          "field": "note_x",
          "type": "quantitative"
        }
      }
    }
  ],
  "config": {
    "background": null,
    "font": "'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif",
    "title": {
      "fontSize": 14,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#2B1D13",
      "subtitleFontSize": 12.5,
      "subtitleColor": "#6B5847",
      "subtitlePadding": 4
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#4A3B2E",
      "titleColor": "#2B1D13"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#4A3B2E",
      "titleColor": "#2B1D13"
    },
    "view": {
      "stroke": null
    }
  }
}
