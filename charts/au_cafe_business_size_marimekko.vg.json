{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Café and restaurant businesses by state and number of employees, June 2025"
  },
  "width": "container",
  "height": 360,
  "data": {
    "url": "data/processed/au_cafes_restaurants_by_state.csv"
  },
  "transform": [
    {
      "calculate": "{'New South Wales':'NSW','Victoria':'VIC','Queensland':'QLD','South Australia':'SA','Western Australia':'WA','Tasmania':'TAS','Northern Territory':'NT','Australian Capital Territory':'ACT'}[datum.state_name]",
      "as": "abbr"
    },
    {
      "calculate": "toNumber(datum.non_employing)",
      "as": "owner"
    },
    {
      "calculate": "toNumber(datum.employees_1_4)+toNumber(datum.employees_5_19)",
      "as": "small"
    },
    {
      "calculate": "toNumber(datum.employees_20_199)+toNumber(datum.employees_200_plus)",
      "as": "large"
    },
    {
      "calculate": "indexof(['ACT','TAS','NT'], datum.abbr) >= 0 ? 'ACT, NT, TAS' : datum.abbr",
      "as": "grp"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "owner",
          "as": "owner"
        },
        {
          "op": "sum",
          "field": "small",
          "as": "small"
        },
        {
          "op": "sum",
          "field": "large",
          "as": "large"
        }
      ],
      "groupby": [
        "grp"
      ]
    },
    {
      "calculate": "datum.grp",
      "as": "abbr"
    },
    {
      "calculate": "datum.grp === 'ACT, NT, TAS' ? 'ACT, NT and Tasmania' : datum.grp",
      "as": "state_name"
    },
    {
      "calculate": "datum.owner + datum.small + datum.large",
      "as": "state_total"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "state_total",
          "as": "grand_total"
        }
      ]
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "state_total",
          "as": "cum_total"
        }
      ],
      "sort": [
        {
          "field": "state_total",
          "order": "descending"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "calculate": "(datum.cum_total - datum.state_total) / datum.grand_total",
      "as": "x0"
    },
    {
      "calculate": "datum.cum_total / datum.grand_total",
      "as": "x1"
    },
    {
      "calculate": "(datum.x0 + datum.x1) / 2",
      "as": "x_mid"
    },
    {
      "calculate": "datum.state_total / datum.grand_total",
      "as": "state_share"
    },
    {
      "fold": [
        "owner",
        "small",
        "large"
      ],
      "as": [
        "size_key",
        "businesses"
      ]
    },
    {
      "calculate": "toNumber(datum.businesses)",
      "as": "n"
    },
    {
      "calculate": "datum.n / datum.state_total",
      "as": "share"
    },
    {
      "calculate": "{'owner':'No employees','small':'1 to 19 employees','large':'20 or more employees'}[datum.size_key]",
      "as": "size_label"
    },
    {
      "calculate": "{'owner':0,'small':1,'large':2}[datum.size_key]",
      "as": "size_order"
    },
    {
      "stack": "share",
      "groupby": [
        "state_name"
      ],
      "sort": [
        {
          "field": "size_order",
          "order": "ascending"
        }
      ],
      "as": [
        "y0",
        "y1"
      ]
    },
    {
      "calculate": "(datum.y0 + datum.y1) / 2",
      "as": "y_mid"
    }
  ],
  "encoding": {
    "x": {
      "field": "x0",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          1.17
        ],
        "nice": false
      },
      "axis": {
        "title": "Share of all cafés and restaurants in Australia",
        "values": [
          0,
          0.25,
          0.5,
          0.75,
          1
        ],
        "format": "%",
        "grid": false,
        "domain": false,
        "tickColor": "#C9BBA8"
      }
    },
    "y": {
      "field": "y0",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          1.08
        ],
        "nice": false
      },
      "axis": {
        "title": "Share of the state's businesses",
        "values": [
          0,
          0.25,
          0.5,
          0.75,
          1
        ],
        "format": "%",
        "grid": false,
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "Size_highlight",
          "select": {
            "type": "point",
            "fields": [
              "size_label"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "#FAF6F0",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x2": {
          "field": "x1"
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "size_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "No employees",
              "1 to 19 employees",
              "20 or more employees"
            ],
            "range": [
              "#A9562F",
              "#E7DCCD",
              "#7E6D5F"
            ]
          },
          "legend": {
            "title": "Employees (click to highlight)",
            "titleLimit": 320,
            "orient": "bottom",
            "direction": "horizontal",
            "labelLimit": 200,
            "symbolType": "square",
            "symbolSize": 140
          }
        },
        "opacity": {
          "condition": {
            "param": "Size_highlight",
            "value": 1
          },
          "value": 0.2
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "size_label",
            "title": "Number of employees"
          },
          {
            "field": "n",
            "type": "quantitative",
            "title": "Businesses",
            "format": ","
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share of the state's businesses",
            "format": ".1%"
          },
          {
            "field": "state_total",
            "type": "quantitative",
            "title": "All businesses in the state",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state_share >= 0.04 && datum.share >= 0.07"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative"
        },
        "y": {
          "field": "y_mid",
          "type": "quantitative"
        },
        "text": {
          "field": "share",
          "type": "quantitative",
          "format": ".0%"
        },
        "color": {
          "condition": {
            "test": "datum.size_order === 1",
            "value": "#2B1D13"
          },
          "value": "#FFFFFF"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.size_order === 0 && datum.state_share >= 0.05"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "dy": -4,
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#2B1D13"
      },
      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative"
        },
        "y": {
          "datum": 1
        },
        "text": {
          "field": "abbr"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.size_order === 0 && datum.state_share < 0.05"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "dy": -30,
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#2B1D13",
        "lineBreak": ", ",
        "lineHeight": 13
      },
      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative"
        },
        "y": {
          "datum": 1
        },
        "text": {
          "field": "abbr"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 1.025,
            "y": 0.13
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12.5,
        "fontWeight": 600,
        "color": "#2B1D13",
        "text": [
          "Victoria has the",
          "highest share of",
          "businesses with no",
          "employees: 26%."
        ]
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        }
      }
    }
  ],
  "config": {
    "background": null,
    "font": "Inter, 'Helvetica Neue', Arial, sans-serif",
    "title": {
      "fontSize": 14,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#2B1D13",
      "subtitleFontSize": 12.5,
      "subtitleColor": "#6B5847",
      "subtitlePadding": 4
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#4A3B2E",
      "titleColor": "#2B1D13"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#4A3B2E",
      "titleColor": "#2B1D13"
    },
    "view": {
      "stroke": null
    }
  }
}