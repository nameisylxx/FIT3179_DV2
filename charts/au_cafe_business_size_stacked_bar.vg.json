{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Share of cafés and restaurants by number of employees",
    "subtitle": "By state or territory, June 2025. Each bar adds up to 100%"
  },
  "width": "container",
  "height": 330,
  "data": {"url": "data/processed/au_cafes_restaurants_by_state.csv"},
  "transform": [
    {
      "calculate": "{'New South Wales':'NSW','Victoria':'VIC','Queensland':'QLD','South Australia':'SA','Western Australia':'WA','Tasmania':'TAS','Northern Territory':'NT','Australian Capital Territory':'ACT'}[datum.state_name]",
      "as": "abbr"
    },
    {"calculate": "toNumber(datum.non_employing) / (toNumber(datum.non_employing) + toNumber(datum.employees_1_4) + toNumber(datum.employees_5_19) + toNumber(datum.employees_20_199) + toNumber(datum.employees_200_plus))", "as": "owner_operator_share"},
    {
      "fold": ["non_employing", "employees_1_4", "employees_5_19", "employees_20_199", "employees_200_plus"],
      "as": ["size_key", "businesses"]
    },
    {"calculate": "toNumber(datum.businesses)", "as": "n"},
    {
      "calculate": "{'non_employing':'None (owner only)','employees_1_4':'1 to 4','employees_5_19':'5 to 19','employees_20_199':'20 to 199','employees_200_plus':'200 or more'}[datum.size_key]",
      "as": "size_label"
    },
    {
      "calculate": "{'non_employing':0,'employees_1_4':1,'employees_5_19':2,'employees_20_199':3,'employees_200_plus':4}[datum.size_key]",
      "as": "size_order"
    },
    {"window": [{"op": "sum", "field": "n", "as": "state_total"}], "groupby": ["state_name"], "frame": [null, null]},
    {"calculate": "datum.n / datum.state_total", "as": "share"}
  ],
  "layer": [
    {
      "mark": {"type": "bar", "stroke": "#FAF6F0", "strokeWidth": 1.5},
      "encoding": {
        "y": {
          "field": "abbr",
          "type": "nominal",
          "sort": ["VIC", "NSW", "WA", "SA", "QLD", "ACT", "TAS", "NT"],
          "axis": {"title": null, "labelFontSize": 13, "labelFontWeight": 600, "ticks": false, "domain": false}
        },
        "x": {
          "field": "share",
          "type": "quantitative",
          "stack": "zero",
          "scale": {"domain": [0, 1.4]},
          "axis": {"title": null, "values": [0, 0.25, 0.5, 0.75, 1], "format": "%", "grid": false, "domain": false}
        },
        "color": {
          "field": "size_label",
          "type": "nominal",
          "scale": {
            "domain": ["None (owner only)", "1 to 4", "5 to 19", "20 to 199", "200 or more"],
            "range": ["#E3E7EA", "#B9C4CD", "#8A9CAA", "#5C7080", "#33434F"]
          },
          "legend": {"title": "Number of employees", "titleLimit": 260, "orient": "bottom", "direction": "horizontal", "labelLimit": 200, "symbolType": "square", "symbolSize": 140}
        },
        "order": {"field": "size_order", "sort": "ascending"},
        "tooltip": [
          {"field": "state_name", "title": "State"},
          {"field": "size_label", "title": "Number of employees"},
          {"field": "n", "title": "Businesses", "format": ","},
          {"field": "share", "title": "Share of state total", "format": ".1%"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.share >= 0.08"}],
      "mark": {"type": "text", "fontSize": 12, "fontWeight": 600},
      "encoding": {
        "y": {"field": "abbr", "type": "nominal", "sort": ["VIC", "NSW", "WA", "SA", "QLD", "ACT", "TAS", "NT"]},
        "x": {"field": "share", "type": "quantitative", "stack": "zero", "bandPosition": 0.5},
        "text": {"field": "share", "type": "quantitative", "format": ".0%"},
        "order": {"field": "size_order", "sort": "ascending"},
        "color": {
          "condition": {"test": "datum.size_order <= 2", "value": "#2B1D13"},
          "value": "#FFFFFF"
        }
      }
    },
    {
      "data": {"values": [{"x": 1.04, "abbr": "VIC"}]},
      "mark": {"type": "text", "align": "left", "baseline": "middle", "fontSize": 13, "fontWeight": 600, "color": "#2B1D13", "text": ["Victoria: 1 in 4 has no", "employees. The owner", "does the work."]},
      "encoding": {
        "y": {"field": "abbr", "type": "nominal", "sort": ["VIC", "NSW", "WA", "SA", "QLD", "ACT", "TAS", "NT"]},
        "x": {"field": "x", "type": "quantitative"}
      }
    },
    {
      "data": {"values": [{"x": 1.04, "abbr": "SA"}]},
      "mark": {"type": "text", "align": "left", "baseline": "middle", "fontSize": 13, "fontWeight": 600, "color": "#2B1D13", "text": ["Across Australia, 91%", "have fewer than 20", "employees."]},
      "encoding": {
        "y": {"field": "abbr", "type": "nominal", "sort": ["VIC", "NSW", "WA", "SA", "QLD", "ACT", "TAS", "NT"]},
        "x": {"field": "x", "type": "quantitative"}
      }
    }
  ],
  "config": {
    "background": null,
    "font": "'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif",
    "title": {"fontSize": 14, "fontWeight": 600, "anchor": "start", "color": "#2B1D13", "subtitleFontSize": 12.5, "subtitleColor": "#6B5847", "subtitlePadding": 4},
    "axis": {"labelFontSize": 12, "titleFontSize": 12, "titleFontWeight": 600, "labelColor": "#4A3B2E", "titleColor": "#2B1D13"},
    "legend": {"labelFontSize": 12, "titleFontSize": 12, "titleFontWeight": 600, "labelColor": "#4A3B2E", "titleColor": "#2B1D13"},
    "view": {"stroke": null}
  }
}
